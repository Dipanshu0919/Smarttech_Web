# ==============================================================================
# SmarTech Solutions - Git Ignore Configuration
# Prevents sensitive credentials, private databases, and runtime files from leak
# ==============================================================================

# Private Environment & Secret Credentials
secrets.php
.env
.env.*
*.env

# Local Databases (Contains private user credentials and client data)
*.sqlite
database.sqlite
*.db

# Client Order Uploads & Private Attachments
orderformfiles/*
!orderformfiles/.gitkeep
assets/blog_images/*
!assets/blog_images/.gitkeep

# Error Logs and Runtime Output
error_log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System Caches & Meta Files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# IDE, Editor, and Workspace Settings
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.gemini/
scratch/

# Temporary and Editor Swap Files
*.tmp
*.bak
*.swp
*.swo
*~


# Protect sensitive files from direct web access
<FilesMatch "^(secrets\.php|\.env|.*\.sqlite|.*\.db)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Deliver assets directly even if requested from /blog/ or /case-study/
RewriteRule ^blog/(assets/.*)$ $1 [L,QSA]
RewriteRule ^case-study/(assets/.*)$ $1 [L,QSA]
RewriteRule ^case-studies/(assets/.*)$ $1 [L,QSA]

# Route blog post slugs
RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog-post.php?slug=$1 [L,QSA]
RewriteRule ^blog/?$ blog.php [L,QSA]

# Route case study slugs
RewriteRule ^case-study/([a-zA-Z0-9-]+)/?$ case-study-post.php?slug=$1 [L,QSA]
RewriteRule ^case-studies/([a-zA-Z0-9-]+)/?$ case-study-post.php?slug=$1 [L,QSA]
RewriteRule ^case-study/?$ case-study.php [L,QSA]
RewriteRule ^case-studies/?$ case-study.php [L,QSA]

# Deliver existing files directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>
